diff --git a/deploy/nginx/paperclipai.cn.conf b/deploy/nginx/paperclipai.cn.conf
new file mode 100644
index 0000000..7203110
--- /dev/null
+++ b/deploy/nginx/paperclipai.cn.conf
@@ -0,0 +1,12 @@
+server {
+    listen 80;
+    listen [::]:80;
+    server_name paperclipai.cn;
+
+    root /var/www/penclip-website/current-cn;
+    index index.html;
+
+    location / {
+        try_files $uri $uri/ =404;
+    }
+}
diff --git a/deploy/nginx/penclip.ing.conf b/deploy/nginx/penclip.ing.conf
