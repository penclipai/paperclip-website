+    { hreflang: 'x-default', href: getAbsoluteUrl(pathname, BRAND.internationalDomain) }
+  ];
+}
+
+export function getRobotsContent(index = true): string {
+  return index ? 'index,follow,max-image-preview:large' : 'noindex,follow';
+}
