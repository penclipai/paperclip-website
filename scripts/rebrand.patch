+      '@type': 'Organization',
+      name: BRAND.name,
+      alternateName: CURRENT_SITE.alternateName,
+      url,
+      logo: getAbsoluteUrl('/og.png'),
+      sameAs: [CURRENT_SITE.firstPartyRepoUrl, CURRENT_SITE.firstPartyWebsiteRepoUrl]
