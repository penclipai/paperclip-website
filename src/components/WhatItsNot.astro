---
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);

const isChinese = site.isChinese;
const items = isChinese
  ? [
      {
        label: '不只是聊天窗口。',
        detail: '它更适合围绕任务分工、协作流转和执行结果来组织工作。'
      },
      {
        label: '不负责训练智能体。',
        detail: 'Paperclip CN 不限制你怎样实现智能体，更关注它们如何被组织起来一起工作。'
      },
      {
        label: '不以拖拽流程为核心。',
        detail: '这里不是流程图工具，更适合管理团队分工、目标、预算和确认步骤。'
      },
      {
        label: '不替代你现有的提示词工具。',
        detail: '智能体可以继续使用自己的提示词、模型和运行方式，Paperclip CN 负责协作关系和任务推进。'
      },
      {
        label: '更适合多角色协作。',
        detail: '如果你只有一个简单脚本，可能不需要这么完整的能力；如果有多个角色和持续任务，就更能体现价值。'
      }
    ]
  : [
      {
        label: 'Not a chatbot.',
        detail: 'There is no conversation-first interface. Agents have jobs, not chat windows.'
      },
      {
        label: 'Not an agent framework.',
        detail: 'Paperclip CN does not tell you how to build agents. It tells you how to run a company made of them.'
      },
      {
        label: 'Not a workflow builder.',
        detail: 'No drag-and-drop pipelines. Paperclip CN models companies with org charts, goals, budgets, and governance.'
      },
      {
        label: 'Not a prompt manager.',
        detail: 'Agents bring their own prompts, models, and runtimes. Paperclip CN manages the organization they work in.'
      },
      {
        label: 'Not a single-agent tool.',
        detail: 'This is for teams, hierarchies, and companies. If you have one agent, you probably do not need Paperclip CN. If you have twenty, you definitely do.'
      }
    ];
---

<section class="diff-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="diff-header">
      <span class="section-badge">{isChinese ? '产品边界' : 'Differentiation'}</span>
      <h2 class="heading-serif diff-heading">{isChinese ? 'Paperclip CN 更适合哪些场景。' : 'What Paperclip CN is not.'}</h2>
    </div>
    <div class="diff-grid">
      {items.map((item, i) => (
        <div class:list={['diff-item', i === 4 && 'diff-item-wide']}>
          <h3 class="diff-label">{item.label}</h3>
          <p class="diff-detail">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .diff-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .diff-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .diff-item {
    background: var(--color-bg);
    padding: var(--space-lg) var(--space-md);
  }

  .diff-item-wide {
    grid-column: span 2;
  }

  .diff-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .diff-detail {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }

    .diff-item-wide {
      grid-column: span 1;
    }
  }
</style>
