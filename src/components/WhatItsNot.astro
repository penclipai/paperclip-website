---
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);

const isChinese = site.isChinese;
const items = isChinese
  ? [
      {
        label: '不是聊天机器人。',
        detail: '这里不是单纯的聊天窗口集合，更强调任务分工、协作流转和执行结果。'
      },
      {
        label: '不是智能体开发框架。',
        detail: 'Penclip 不限制你怎样实现智能体，它更关注这些执行者如何被组织、协作和管理。'
      },
      {
        label: '不是工作流搭积木工具。',
        detail: '这里没有以拖拽为核心的流程编排，而是围绕组织结构、目标、预算和审批来管理执行过程。'
      },
      {
        label: '不是 Prompt 管理器。',
        detail: '智能体可以继续使用自己的 prompt、模型和运行环境，Penclip 管的是协作关系和控制规则。'
      },
      {
        label: '不是单智能体玩具。',
        detail: '它更适合团队、多角色和多任务协作场景。如果你只有一个简单脚本，可能还不需要这么完整的控制层。'
      }
    ]
  : [
      {
        label: 'Not a chatbot.',
        detail: 'There is no conversation-first interface. Agents have jobs, not chat windows.'
      },
      {
        label: 'Not an agent framework.',
        detail: 'Penclip does not tell you how to build agents. It tells you how to run a company made of them.'
      },
      {
        label: 'Not a workflow builder.',
        detail: 'No drag-and-drop pipelines. Penclip models companies with org charts, goals, budgets, and governance.'
      },
      {
        label: 'Not a prompt manager.',
        detail: 'Agents bring their own prompts, models, and runtimes. Penclip manages the organization they work in.'
      },
      {
        label: 'Not a single-agent tool.',
        detail: 'This is for teams, hierarchies, and companies. If you have one agent, you probably do not need Penclip. If you have twenty, you definitely do.'
      }
    ];
---

<section class="diff-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="diff-header">
      <span class="section-badge">{isChinese ? '产品边界' : 'Differentiation'}</span>
      <h2 class="heading-serif diff-heading">{isChinese ? 'Penclip 不是什么。' : 'What Penclip is not.'}</h2>
    </div>
    <div class="diff-grid">
      {items.map((item, i) => (
        <div class:list={['diff-item', i === 4 && 'diff-item-wide']}>
          <h3 class="diff-label">{item.label}</h3>
          <p class="diff-detail">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .diff-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .diff-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .diff-item {
    background: var(--color-bg);
    padding: var(--space-lg) var(--space-md);
  }

  .diff-item-wide {
    grid-column: span 2;
  }

  .diff-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .diff-detail {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }

    .diff-item-wide {
      grid-column: span 1;
    }
  }
</style>
