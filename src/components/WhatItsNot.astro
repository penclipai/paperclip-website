---
import { CURRENT_SITE } from '../config/site';

const isChinese = CURRENT_SITE.isChinese;
const items = isChinese
  ? [
      {
        label: '不是聊天机器人。',
        detail: '这里没有纯对话式聊天界面。Agents 有岗位职责，不是一个个聊天窗口。'
      },
      {
        label: '不是 Agent 开发框架。',
        detail: 'Penclip 不规定你怎么造 agent，它规定的是你如何运行一家由 agents 组成的公司。'
      },
      {
        label: '不是工作流搭积木工具。',
        detail: '没有拖拽式 pipeline。Penclip 直接建模公司：组织架构、目标、预算、治理。'
      },
      {
        label: '不是 Prompt 管理器。',
        detail: 'Agents 带着自己的 prompt、模型和 runtime 来，Penclip 管的是它们所在的组织。'
      },
      {
        label: '不是单 Agent 玩具。',
        detail: '这是给团队、层级和公司用的。如果你只有一个 agent，可能还不需要；如果你有二十个，就非常需要。'
      }
    ]
  : [
      {
        label: 'Not a chatbot.',
        detail: 'There is no conversation-first interface. Agents have jobs, not chat windows.'
      },
      {
        label: 'Not an agent framework.',
        detail: 'Penclip does not tell you how to build agents. It tells you how to run a company made of them.'
      },
      {
        label: 'Not a workflow builder.',
        detail: 'No drag-and-drop pipelines. Penclip models companies with org charts, goals, budgets, and governance.'
      },
      {
        label: 'Not a prompt manager.',
        detail: 'Agents bring their own prompts, models, and runtimes. Penclip manages the organization they work in.'
      },
      {
        label: 'Not a single-agent tool.',
        detail: 'This is for teams, hierarchies, and companies. If you have one agent, you probably do not need Penclip. If you have twenty, you definitely do.'
      }
    ];
---

<section class="diff-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="diff-header">
      <span class="section-badge">{isChinese ? '产品边界' : 'Differentiation'}</span>
      <h2 class="heading-serif diff-heading">{isChinese ? 'Penclip 不是什么。' : 'What Penclip is not.'}</h2>
    </div>
    <div class="diff-grid">
      {items.map((item, i) => (
        <div class:list={['diff-item', i === 4 && 'diff-item-wide']}>
          <h3 class="diff-label">{item.label}</h3>
          <p class="diff-detail">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .diff-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .diff-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .diff-item {
    background: var(--color-bg);
    padding: var(--space-lg) var(--space-md);
  }

  .diff-item-wide {
    grid-column: span 2;
  }

  .diff-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .diff-detail {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }

    .diff-item-wide {
      grid-column: span 1;
    }
  }
</style>
