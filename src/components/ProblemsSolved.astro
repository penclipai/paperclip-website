---
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);

const isChinese = site.isChinese;
const problems = isChinese
  ? [
      {
        without: '你同时开着 20 个 Claude Code 标签页，却不知道谁在做什么；一重启，进度全丢。',
        with: '任务以 ticket 为中心，对话成线程，session 跨重启持续存在。'
      },
      {
        without: '你要手动从多个地方拼上下文，反复提醒 bot 现在到底在做什么。',
        with: '上下文从任务一直关联到项目与公司目标，agent 天然知道该做什么、为什么做。'
      },
      {
        without: 'Agent 配置散落各处，你还得自己重造任务管理、协作和调度系统。',
        with: 'Penclip 把组织架构、ticket、委派和治理开箱给你，你运行的是公司，不是一堆脚本。'
      },
      {
        without: '失控循环几分钟就烧掉几百美元 token，等你发现时额度已经见底。',
        with: '成本追踪会把预算与消耗直接暴露出来，超限自动节流，由管理层按预算做优先级。'
      },
      {
        without: '客服、内容、日报这类周期性工作，总得你自己记得去手动触发。',
        with: 'Heartbeat 会按计划接管这些重复性工作，管理层只负责监督。'
      },
      {
        without: '你有个想法，还得找仓库、开 Claude Code、盯着窗口，整个过程靠人工 babysit。',
        with: '直接在 Penclip 里下发任务，编码 agent 会持续推进直到完成，再由管理层审阅。'
      }
    ]
  : [
      {
        without: "You have 20 Claude Code tabs open and cannot track which one does what. On reboot you lose everything.",
        with: 'Tasks are ticket-based, conversations are threaded, and sessions persist across reboots.'
      },
      {
        without: "You manually gather context from several places to remind your bot what you're actually doing.",
        with: 'Context flows from the task up through the project and company goals, so your agent always knows what to do and why.'
      },
      {
        without: 'Folders of agent configs are disorganized and you are re-inventing task management, communication, and coordination between agents.',
        with: 'Penclip gives you org charts, ticketing, delegation, and governance out of the box, so you run a company instead of a pile of scripts.'
      },
      {
        without: 'Runaway loops waste hundreds of dollars of tokens and max your quota before you even know what happened.',
        with: 'Cost tracking surfaces token budgets and throttles agents when they are out. Management prioritizes with budgets.'
      },
      {
        without: 'You have recurring jobs like customer support, social scheduling, and reporting that still depend on manual triggers.',
        with: 'Heartbeats handle regular work on a schedule while management supervises.'
      },
      {
        without: 'You have an idea, then you have to find your repo, fire up Claude Code, keep a tab open, and babysit it.',
        with: 'Add a task in Penclip. Your coding agent works on it until it is done. Management reviews the outcome.'
      }
    ];
---

<section class="problems-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="problems-header">
      <span class="section-badge">{isChinese ? '解决的问题' : 'Problems Solved'}</span>
      <h2 class="heading-serif problems-heading">
        {isChinese ? '用了 Penclip，会发生什么变化。' : 'What changes with Penclip.'}
      </h2>
    </div>
    <div class="problems-list">
      {problems.map((p) => (
        <div class="problem-row" data-animate-problem>
          <div class="problem-without">
            <span class="problem-label problem-label-without">{isChinese ? '没有 Penclip' : 'Without'}</span>
            <p>{p.without}</p>
          </div>
          <div class="problem-arrow">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" /><path d="M12 5l7 7-7 7" />
            </svg>
          </div>
          <div class="problem-with">
            <span class="problem-label problem-label-with">{isChinese ? '使用 Penclip' : 'With Penclip'}</span>
            <p>{p.with}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problems-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .problems-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .problems-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .problem-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    background: var(--color-bg);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .problem-row.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .problem-without,
  .problem-with {
    padding: var(--space-md);
  }

  .problem-without {
    border-right: 1px solid var(--color-border);
  }

  .problem-with {
    border-left: 1px solid var(--color-border);
  }

  .problem-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-sm);
    color: var(--color-text-muted);
  }

  .problem-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-pill);
    margin-bottom: 0.5rem;
  }

  .problem-label-without {
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .problem-label-with {
    color: var(--color-text);
    background: var(--color-surface-raised);
  }

  .problem-without p,
  .problem-with p {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .problem-row {
      grid-template-columns: 1fr;
    }

    .problem-without {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .problem-with {
      border-left: none;
    }

    .problem-arrow {
      padding: var(--space-xs);
      justify-content: flex-start;
      padding-left: var(--space-md);
      transform: rotate(90deg);
    }
  }
</style>

<script>
  const rows = document.querySelectorAll('.problem-row[data-animate-problem]');
  if (rows.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const row = entry.target as HTMLElement;
            const index = Array.from(rows).indexOf(row);
            setTimeout(() => {
              row.classList.add('is-visible');
            }, index * 100);
            observer.unobserve(row);
          }
        });
      },
      { threshold: 0.05 }
    );
    rows.forEach((row) => observer.observe(row));
  }
</script>
