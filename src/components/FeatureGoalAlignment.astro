---
import { CURRENT_SITE } from '../config/site';

const content = CURRENT_SITE.isChinese
  ? {
      badge: '目标对齐',
      heading: ['让每个 agent 都', '对准同一个目标。'],
      levels: [
        { label: '公司使命', text: '做到 200 万美元 ARR，做成第一的 AI 记笔记应用' },
        { label: '项目目标', text: '上线协作功能' },
        { label: 'Agent 目标', text: '实现实时同步' },
        { label: '任务', text: '编写文档更新的 WebSocket 处理器' }
      ],
      paragraphs: [
        '每一项工作都会拿到可追溯到公司使命的上下文。你的 agents 不只知道要做什么，也知道为什么要做。',
        'Penclip 的'
      ]
    }
  : {
      badge: 'Goal Alignment',
      heading: ['Keep your agents aligned', 'on the goal.'],
      levels: [
        { label: 'Company Mission', text: 'Make $2mm ARR with the #1 AI note-taking app' },
        { label: 'Project Goal', text: 'Ship collaboration features' },
        { label: 'Agent Goal', text: 'Implement real-time sync' },
        { label: 'Task', text: 'Write WebSocket handler for document updates' }
      ],
      paragraphs: [
        'Every piece of work is given context that traces back to the company mission. Your agents will know what to do and why.',
        'Penclip'
      ]
    };
---

<section class="feature-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="feature-header">
      <span class="section-badge">{content.badge}</span>
      <h2 class="heading-serif feature-heading">{content.heading[0]}<br />{content.heading[1]}</h2>
    </div>
    <div class="feature-layout">
      <div class="feature-graphic">
        <div class="goal-cascade">
          <div class="goal-level goal-level-1">
            <span class="goal-icon">&#9678;</span>
            <div>
              <span class="goal-label">{content.levels[0].label}</span>
              <span class="goal-text">{content.levels[0].text}</span>
            </div>
          </div>
          <div class="goal-connector"></div>
          <div class="goal-level goal-level-2">
            <span class="goal-icon">&#9673;</span>
            <div>
              <span class="goal-label">{content.levels[1].label}</span>
              <span class="goal-text">{content.levels[1].text}</span>
            </div>
          </div>
          <div class="goal-connector"></div>
          <div class="goal-level goal-level-3">
            <span class="goal-icon">&#9675;</span>
            <div>
              <span class="goal-label">{content.levels[2].label}</span>
              <span class="goal-text">{content.levels[2].text}</span>
            </div>
          </div>
          <div class="goal-connector"></div>
          <div class="goal-level goal-level-4">
            <span class="goal-icon">&#8226;</span>
            <div>
              <span class="goal-label">{content.levels[3].label}</span>
              <span class="goal-text">{content.levels[3].text}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="feature-copy">
        <p class="feature-sub">
          {content.paragraphs[0]}
        </p>
        <p class="feature-sub">
          {content.paragraphs[1]} <code>SKILLS.md</code> {CURRENT_SITE.isChinese
            ? '机制让 agents 知道该如何发现自己需要的上下文。'
            : 'means your agents know how to discover the context they need.'}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .feature-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: var(--space-sm);
  }

  .feature-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .feature-graphic {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .feature-copy {
    padding-top: var(--space-sm);
  }

  .feature-sub {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 440px;
    margin-bottom: var(--space-md);
  }

  .goal-cascade {
    display: flex;
    flex-direction: column;
  }

  .goal-level {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    opacity: 0;
    transform: translateY(12px);
  }

  .goal-level.visible {
    animation: cascadeIn 0.45s ease-out forwards;
  }

  .goal-connector {
    width: 2px;
    height: 20px;
    background: transparent;
    margin-left: 2.5rem;
  }

  .goal-connector.visible {
    animation: connectorGrow 0.3s ease-out forwards;
  }

  @keyframes cascadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes connectorGrow {
    from {
      background: transparent;
    }
    to {
      background: var(--color-border);
    }
  }

  .goal-icon {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    width: 24px;
    text-align: center;
  }

  .goal-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .goal-text {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .goal-level-2 {
    margin-left: 1.5rem;
  }

  .goal-level-3 {
    margin-left: 3rem;
  }

  .goal-level-4 {
    margin-left: 4.5rem;
  }

  .goal-level-2 ~ .goal-connector {
    margin-left: 4rem;
  }

  .goal-level-3 ~ .goal-connector {
    margin-left: 5.5rem;
  }

  @media (max-width: 768px) {
    .feature-layout {
      grid-template-columns: 1fr;
    }

    .feature-graphic {
      order: 1;
    }

    .feature-copy {
      order: 2;
    }
  }

  @media (max-width: 640px) {
    .goal-level-2,
    .goal-level-3,
    .goal-level-4 {
      margin-left: 0;
    }

    .goal-connector {
      margin-left: 2.5rem !important;
    }
  }
</style>

<script>
  const cascade = document.querySelector('.goal-cascade');
  if (cascade) {
    const items = cascade.querySelectorAll('.goal-level, .goal-connector');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            items.forEach((item, i) => {
              setTimeout(() => {
                item.classList.add('visible');
              }, i * 180);
            });
          } else {
            items.forEach((item) => {
              item.classList.remove('visible');
            });
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(cascade);
  }
</script>
