---
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);

const { footer } = site.home;
const { communityCard, legalFooter } = site;
---

<footer class="footer">
  <div class="footer-bg">
    <picture>
      <source srcset="/footer-bg.webp" type="image/webp" />
      <img src="/footer-bg.jpg" alt="" width="1920" height="960" loading="lazy" />
    </picture>
  </div>

  <div class="footer-content">
    <div class="container footer-columns">
      {footer.columns.map((column) => (
        <div class="footer-col">
          <h4 class="footer-col-heading">{column.heading}</h4>
          {column.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))}
    </div>

    {communityCard?.show && (
      <div class="container footer-community" id="community">
        <div class="community-card">
          <img
            src={communityCard.imageSrc}
            alt={communityCard.title}
            width="160"
            height="160"
            loading="lazy"
          />
          <div class="community-copy">
            <h4>{communityCard.title}</h4>
            <p>{communityCard.description}</p>
          </div>
        </div>
      </div>
    )}

    {legalFooter?.show && (
      <div class="container footer-legal">
        <span>{legalFooter.icp}</span>
        <span>{legalFooter.publicSecurity}</span>
      </div>
    )}

    <div class="container footer-bottom">
      <span class="footer-copy">&copy; {new Date().getFullYear()} {footer.copyright}</span>
      <!-- <div class="footer-bottom-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </div> -->
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
  }

  /* Background image — covers full footer area */
  .footer-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .footer-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Semi-transparent overlay so text reads clearly */
  .footer-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 30, 50, 0.65) 0%,
      rgba(20, 30, 50, 0.55) 60%,
      rgba(20, 30, 50, 0.7) 100%
    );
  }

  .footer-content {
    position: relative;
    z-index: 1;
  }

  /* ── Link columns ── */
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: var(--space-xl);
  }

  .footer-col-heading {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .footer-col a {
    display: block;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    padding: 0.25rem 0;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: #ffffff;
  }

  .footer-community {
    padding-bottom: var(--space-lg);
  }

  .community-card {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: min(100%, 560px);
    padding: var(--space-md);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(6px);
  }

  .community-card img {
    width: 128px;
    height: 128px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.94);
    flex-shrink: 0;
  }

  .community-copy h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .community-copy p {
    max-width: 24rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-bottom: var(--space-md);
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.8rem;
  }

  /* ── Bottom bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer-bottom-links {
    display: flex;
    gap: var(--space-md);
  }

  .footer-bottom-links a {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s;
  }

  .footer-bottom-links a:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg) var(--space-md);
    }

    .community-card {
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }

    .community-card {
      flex-direction: column;
    }

    .community-card img {
      width: 120px;
      height: 120px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
