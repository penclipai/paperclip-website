---
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);

const isChinese = site.isChinese;
const items = isChinese
  ? [
      {
        label: '把智能体放进清晰的分工里。',
        detail: '角色、层级和协作关系都能明确下来，不同执行者可以围绕同一项工作配合。'
      },
      {
        label: '把权限和确认放进流程里。',
        detail: '涉及关键操作时，可以先确认再继续，也方便随时调整预算和任务安排。'
      },
      {
        label: '把成本变化看清楚。',
        detail: '每个角色都可以设置预算，每次调用都会留下记录，方便尽早发现异常消耗。'
      },
      {
        label: '把任务过程留下来。',
        detail: '每张任务单、每次决策和关键操作都有记录，后续排查和复盘更容易。'
      },
      {
        label: '把多个团队分开管理。',
        detail: '可以只管理一个团队，也可以同时管理多个业务单元，数据彼此隔离，查看入口保持统一。'
      }
    ]
  : [
      {
        label: 'An org chart for agents.',
        detail: 'Hierarchies, roles, and reporting lines. Your agents do not freelance — they have a boss, a title, and a job description.'
      },
      {
        label: 'A governance layer.',
        detail: 'You sit at the top. Approve hires, review strategy, and override decisions. Agents work for you, not the other way around.'
      },
      {
        label: 'A cost control system.',
        detail: 'Every agent has a budget. Every tool call has a price. You see where money goes before it is gone.'
      },
      {
        label: 'Full observability.',
        detail: 'Every ticket traced. Every decision explained. Every tool call logged. Nothing happens in the dark.'
      },
      {
        label: 'A multi-company runtime.',
        detail: 'Run one AI company or run fifty. Complete isolation between businesses. One install, one control plane, unlimited companies.'
      }
    ];
---

<section class="what-is-section section">
  <div class="container">
    <hr class="section-divider" />
    <div class="what-is-header">
      <span class="section-badge">{isChinese ? '产品定位' : 'Identity'}</span>
      <h2 class="heading-serif what-is-heading">{isChinese ? 'Penclip 可以帮你做什么。' : 'What Penclip is.'}</h2>
    </div>
    <div class="what-is-grid">
      {items.map((item, i) => (
        <div class:list={['what-is-item', i === 4 && 'what-is-item-wide']}>
          <h3 class="what-is-label">{item.label}</h3>
          <p class="what-is-detail">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .what-is-header {
    padding-top: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  .what-is-heading {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .what-is-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .what-is-item {
    background: var(--color-bg);
    padding: var(--space-lg) var(--space-md);
  }

  .what-is-item-wide {
    grid-column: span 2;
  }

  .what-is-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .what-is-detail {
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .what-is-grid {
      grid-template-columns: 1fr;
    }

    .what-is-item-wide {
      grid-column: span 1;
    }
  }
</style>
