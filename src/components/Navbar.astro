---
import { BRAND } from '../config/brand';
import { getSiteForPath } from '../config/site';

const site = getSiteForPath(Astro.url.pathname);
const { navbar } = site.home;
const logoHref =
  site.isChinese && site.domain === BRAND.internationalDomain ? '/zh/' : '/';
---

<nav class="navbar">
  <div class="navbar-inner">
    <div class="navbar-left">
      <a href={navbar.primaryLinkHref} class="navbar-link">{navbar.primaryLinkLabel}</a>
      <a href={site.localeSwitch.href} class="navbar-link">{site.localeSwitch.label}</a>
    </div>
    <a href={logoHref} class="navbar-logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
      </svg>
      <span>{BRAND.name}</span>
    </a>
    <div class="navbar-right">
      <a href={navbar.ctaHref} class="navbar-cta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        {navbar.ctaLabel}
      </a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 12px 20px 0;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76px;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 28px;
    border-radius: 38px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow:
      0 2px 16px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .navbar-left,
  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
  }

  .navbar-left {
    justify-content: flex-start;
  }

  .navbar-right {
    justify-content: flex-end;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    padding: 0 1.5rem;
    white-space: nowrap;
  }

  .navbar-link {
    font-size: 0.85rem;
    font-weight: 450;
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.2s;
  }

  .navbar-link:hover {
    color: #fff;
  }

  .navbar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.12);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background 0.2s, color 0.2s;
  }

  .navbar-cta:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  @media (max-width: 768px) {
    .navbar-inner {
      height: 60px;
      padding: 0 20px;
      border-radius: 30px;
      max-width: 100%;
    }

    .navbar-logo {
      padding: 0 1rem;
    }
  }

  @media (max-width: 480px) {
    .navbar {
      padding: 8px 12px 0;
    }

    .navbar-inner {
      height: 52px;
      padding: 0 16px;
      border-radius: 26px;
    }

    .navbar-logo {
      padding: 0 0.6rem;
      font-size: 0.88rem;
    }

    .navbar-left,
    .navbar-right {
      gap: 0.75rem;
    }

    .navbar-link {
      font-size: 0.8rem;
    }

    .navbar-cta svg {
      display: none;
    }
  }
</style>
