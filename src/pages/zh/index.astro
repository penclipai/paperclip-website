---
import { BRAND } from '../../config/brand';
import { getAbsoluteUrl, getHomeStructuredData, getRobotsContent } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Quickstart from '../../components/Quickstart.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Features from '../../components/Features.astro';
import FeatureOrgChart from '../../components/FeatureOrgChart.astro';
import FeatureGoalAlignment from '../../components/FeatureGoalAlignment.astro';
import FeatureHeartbeats from '../../components/FeatureHeartbeats.astro';
import FeatureCosts from '../../components/FeatureCosts.astro';
import FeatureMultiCompany from '../../components/FeatureMultiCompany.astro';
import FeatureTickets from '../../components/FeatureTickets.astro';
import FeatureExtensions from '../../components/FeatureExtensions.astro';
import FeatureCliphub from '../../components/FeatureCliphub.astro';
import Governance from '../../components/Governance.astro';
import WhatItIs from '../../components/WhatItIs.astro';
import ProblemsSolved from '../../components/ProblemsSolved.astro';
import WhySpecial from '../../components/WhySpecial.astro';
import WhatItsNot from '../../components/WhatItsNot.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';

const structuredData = getHomeStructuredData(Astro.url.pathname);
---

<Layout
  alternateLinks={[]}
  canonicalHref={getAbsoluteUrl('/zh/', BRAND.internationalDomain)}
  lang="zh-CN"
  robots={getRobotsContent(false)}
  structuredData={structuredData}
>
  <Navbar />
  <main>
    <Hero />
    <Quickstart />
    <HowItWorks />
    <Features />
    <FeatureOrgChart />
    <FeatureGoalAlignment />
    <FeatureHeartbeats />
    <FeatureCosts />
    <FeatureMultiCompany />
    <FeatureTickets />
    <FeatureExtensions />
    <FeatureCliphub />
    <Governance />
    <WhatItIs />
    <ProblemsSolved />
    <WhySpecial />
    <WhatItsNot />
    <SeoTopics />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
