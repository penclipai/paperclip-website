---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SEO_GUIDES } from '../config/seo';

interface RelatedGuide {
  href: string;
  label: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  canonicalHref: string;
  alternateLinks?: Array<{ href: string; hreflang: 'zh-CN' | 'en' | 'x-default' }>;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  relatedGuides?: RelatedGuide[];
}

const {
  title,
  description,
  heading,
  intro,
  canonicalHref,
  alternateLinks = [],
  robots,
  structuredData = [],
  relatedGuides = SEO_GUIDES
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonicalHref={canonicalHref}
  alternateLinks={alternateLinks}
  robots={robots}
  structuredData={structuredData}
  lang="zh-CN"
>
  <Navbar />
  <main class="guide-main">
    <section class="guide-hero">
      <div class="container guide-hero-inner">
        <span class="section-badge">Paperclip CN</span>
        <h1 class="heading-serif guide-title">{heading}</h1>
        <p class="guide-intro">{intro}</p>
        <div class="guide-links">
          <a href="/" class="guide-link-primary">返回首页</a>
          <a href="#related-guides" class="guide-link-secondary">继续了解其他专题</a>
        </div>
      </div>
    </section>

    <article class="guide-article">
      <div class="container guide-content">
        <slot />
      </div>
    </article>

    <section class="guide-related section" id="related-guides">
      <div class="container">
        <div class="guide-related-header">
          <span class="section-badge">继续了解</span>
          <h2 class="heading-serif guide-related-title">围绕 Paperclip CN 的几个常见问题。</h2>
        </div>
        <div class="guide-related-grid">
          {relatedGuides.map((guide) => (
            <a class="guide-related-card" href={guide.href}>
              <h3>{guide.label}</h3>
              <p>{guide.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .guide-main {
    padding-top: 7rem;
  }

  .guide-hero {
    padding: 0 0 var(--space-xl);
  }

  .guide-hero-inner {
    max-width: 820px;
  }

  .guide-title {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    margin-bottom: var(--space-sm);
  }

  .guide-intro {
    max-width: 700px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .guide-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .guide-link-primary,
  .guide-link-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.35rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
  }

  .guide-link-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .guide-link-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .guide-article {
    padding-bottom: var(--space-xl);
  }

  .guide-content {
    max-width: 820px;
  }

  .guide-content :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 400;
    line-height: 1.2;
    margin: var(--space-xl) 0 var(--space-sm);
  }

  .guide-content :global(h3) {
    font-size: 1.15rem;
    line-height: 1.4;
    margin: var(--space-md) 0 0.5rem;
  }

  .guide-content :global(p),
  .guide-content :global(li) {
    font-size: 1rem;
    line-height: 1.9;
    color: var(--color-text-secondary);
  }

  .guide-content :global(p + p) {
    margin-top: 0.9rem;
  }

  .guide-content :global(ul) {
    list-style: disc;
    padding-left: 1.2rem;
    margin: 0.9rem 0 0;
  }

  .guide-content :global(ul li + li) {
    margin-top: 0.55rem;
  }

  .guide-content :global(.guide-note) {
    margin-top: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
  }

  .guide-content :global(.guide-note strong) {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-text);
  }

  .guide-related-header {
    max-width: 720px;
    margin-bottom: var(--space-lg);
  }

  .guide-related-title {
    font-size: clamp(2rem, 4vw, 2.7rem);
  }

  .guide-related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .guide-related-card {
    display: block;
    padding: var(--space-md);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .guide-related-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .guide-related-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .guide-main {
      padding-top: 6rem;
    }

    .guide-related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
