---
import { BRAND } from '../config/brand';
import {
  type AlternateLink,
  getAlternateLinks,
  getCanonicalUrl,
  getSiteForPath,
  getRobotsContent
} from '../config/site';

interface Props {
  alternateLinks?: AlternateLink[];
  canonicalHref?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const pathname = Astro.url.pathname;
const site = getSiteForPath(pathname);

const {
  alternateLinks: alternateLinksProp,
  canonicalHref = getCanonicalUrl(pathname),
  title = site.title,
  description = site.description,
  ogImage = '/hero-bg.jpg',
  lang = site.lang,
  robots = getRobotsContent(true),
  structuredData = [],
} = Astro.props;

const canonicalURL = new URL(canonicalHref);
const alternateLinks = alternateLinksProp ?? getAlternateLinks(pathname);
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const ogImageURL = new URL(ogImage, site.siteUrl).href;
const currentLocale = lang === 'zh-CN' ? 'zh_CN' : 'en_US';
const alternateLocale = lang === 'zh-CN' ? 'en_US' : 'zh_CN';
const googleSiteVerificationRaw =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? process.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const googleSiteVerifications = typeof googleSiteVerificationRaw === 'string'
  ? googleSiteVerificationRaw
      .split(/[,\r\n]+/)
      .map((token) => token.trim())
      .filter(Boolean)
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {googleSiteVerifications.map((token) => (
      <meta name="google-site-verification" content={token} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={currentLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="759" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
